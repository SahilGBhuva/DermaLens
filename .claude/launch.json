{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && CORS_ORIGINS=http://localhost:3100,http://localhost:3000 ../.venv/bin/uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
